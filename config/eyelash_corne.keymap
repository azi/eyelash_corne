#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#include <input/processors.dtsi>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

// layers
#define QWERTY 0
#define LOWER  1
#define UPPER  2
#define MAGIC  3

/ {
    behaviors {
        caps_toggle: tap_dance_caps_toggle {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp LS(CAPS)>;
        };
        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sqt_dqt: sqt_dqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        fslh_qmark: fslh_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------------
            // | TAB  ||  Q  |  W  |  E  |  R  |  T  |            |  Y  |  U  |  I  |  O  |  P  || BSPC |
            // | G+SPC||  A  |  S  |  D  |  F  |  G  |            |  H  |  J  |  K  |  L  | '/''|| ESC  |
            // | LALT ||  Z  |  X  |  C  |  V  |  B  |            |  N  |  M  | ,/; | ./: | //? || DEL  |
            //                     | CAPS | LWR/BSPC | SFT/ESC || CTL/RET | UPR/SPC | GUI |
            bindings = <
&kp TAB        &kp Q  &kp W  &kp E        &kp R          &kp T                                &kp UP                 &kp Y        &kp U          &kp I          &kp O      &kp P          &kp BSPC
&kp LG(SPACE)  &kp A  &kp S  &kp D        &kp F          &kp G                  &kp LEFT      &kp ENTER  &kp RIGHT   &kp H        &kp J          &kp K          &kp L      &sqt_dqt       &kp ESC
&kp LALT       &kp Z  &kp X  &kp C        &kp V          &kp B    &kp C_MUTE                  &kp DOWN               &kp N        &kp M          &comma_semi    &dot_colon &fslh_qmark    &kp DEL
                              &caps_toggle &lt LOWER BSPC &mt LSHFT ESC                                                &mt RCTL RET &lt UPPER SPACE &kp LGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            // --------------------------------------------------------------------------------------
            // |  ▽  ||  <  |  [  |  (  |  {  |  `  |            |  *  |  7  |  8  |  9  |  \  ||  ▽  |
            // |  ▽  || GUI | ALT | CTL | SFT |  =  |            |  +  |  4  |  5  |  6  | -/MG||  ▽  |
            // |  ▽  || >/MG|  ]  |  )  |  }  |  ~  |            |  0  |  1  |  2  |  3  | //? ||  ▽  |
            //                     |  ▽  |  ▽  |  ▽  |            |  ▽  |  ▽  |  ▽  |
            bindings = <
&trans  &kp LT           &kp LBKT  &kp LPAR   &kp LBRC   &kp GRAVE                                    &mmv MOVE_UP                     &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9  &kp BSLH        &trans
&trans  &sk LGUI         &sk LALT  &sk LCTRL  &sk LSHFT  &kp KP_EQUAL                 &mmv MOVE_LEFT   &mkp LCLK       &mmv MOVE_RIGHT  &kp KP_PLUS      &kp N4  &kp N5  &kp N6  &lt MAGIC MINUS &trans
&trans  &lt MAGIC GT     &kp RBKT  &kp RPAR   &kp RBRC   &kp TILDE      &trans                        &mmv MOVE_DOWN                   &kp N0           &kp N1  &kp N2  &kp N3  &fslh_qmark     &trans
                                   &trans     &trans     &trans                                                                          &trans           &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        upper_layer {
            display-name = "NAVIGATE";
            // --------------------------------------------------------------------------------------
            // |  ▽  ||  F1  |  F2  |  F3  |  F4  |  F5  |            | G+V  | G+Z  |  UP  |  TAB  |  BSPC  ||  ▽  |
            // |  ▽  ||  GUI |  ALT |  CTL |  SFT | G+SPC|            | G+C  | LEFT  | DOWN | RIGHT | RET/MG ||  ▽  |
            // |  ▽  || F6/MG|  F7  |  F8  |  F9  |  F10 |            | G+X  | HOME  |  ESC | END   |  DEL   ||  ▽  |
            //                       |  ▽  |  ▽  |  ▽  |            |  ▽  |  ▽  |  ▽  |
            bindings = <
&trans  &kp F1        &kp F2   &kp F3    &kp F4    &kp F5                               &mmv MOVE_UP                     &kp LG(V)  &kp LG(Z)  &kp UP    &kp TAB    &kp BSPC       &trans
&trans  &sk LGUI      &sk LALT &sk LCTRL &sk LSHFT &kp LG(SPACE)        &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LG(C)  &kp LEFT   &kp DOWN  &kp RIGHT  &lt MAGIC RET  &trans
&trans  &lt MAGIC F6  &kp F7   &kp F8    &kp F9    &kp F10        &trans                &mmv MOVE_DOWN                   &kp LG(X)  &kp HOME   &kp ESC   &kp END    &kp DEL        &trans
                               &trans    &trans    &trans                                                                 &trans     &trans     &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        magic_layer {
            display-name = "MAGIC";
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_SPI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &bootloader    &none                                   &mmv MOVE_UP                     &bootloader   &kp C_PP     &kp C_VOL_UP  &kp C_MUTE  &rgb_ug RGB_BRI  &none
&rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &sys_reset     &none                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &sys_reset    &kp C_PREV   &kp C_VOL_DN  &kp C_NEXT  &rgb_ug RGB_BRD  &none
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3   &bt BT_CLR_ALL  &none                   &mmv MOVE_DOWN                   &out OUT_USB  &out OUT_BLE &kp F11       &kp F12     &studio_unlock   &none
                                                    &trans           &trans         &trans                                                                    &trans        &trans       &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
